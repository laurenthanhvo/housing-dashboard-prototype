{
  "name": "UCSD Housing Dashboard Theme",
  "dataColors": [
    "#00629B",
    "#C69214",
    "#00C6D7",
    "#182B49",
    "#6E963B",
    "#FC8900",
    "#D462AD",
    "#FFCD00"
  ],
  "background": "#F7F6F2",
  "foreground": "#24313B",
  "tableAccent": "#00629B",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI",
      "fontSize": 14,
      "color": "#182B49"
    },
    "header": {
      "fontFace": "Segoe UI",
      "fontSize": 12,
      "color": "#182B49"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#68757F"
    },
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 22,
      "color": "#182B49"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D8DEE2"
              }
            },
            "radius": 0
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#182B49"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI",
            "bold": false
          }
        ]
      }
    }
  }
}